# SkillSum ResultSetu - Environment Configuration Template
# Copy this file to .env for local customized overrides.

# Application Identity
PROJECT_NAME="SkillSum ResultSetu"
PROJECT_SLUG="skillsum-resultsetu"
OWNER_NAME="SkillSum Innovations"
TAGLINE="Simplify bulk academic result processing."

# Support & Contact (Do not invent emails, configure when provided)
SUPPORT_EMAIL="[SUPPORT_EMAIL_PLACEHOLDER]"

# Server Settings
HOST="127.0.0.1"
PORT=8000
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB
JOB_RETENTION_MINUTES=30       # Temporary file auto-purge TTL

# Headless Automation Settings
SELENIUM_HEADLESS=true
SELENIUM_PAGE_TIMEOUT=30
